 <a class="v7-float-donate" href="/#collabora"><span aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 21C5 16.5 2 12.5 2 8.8 2 6.1 4.1 4 6.7 4c1.9 0 3.7 1 5.3 3 1.6-2 3.4-3 5.3-3C19.9 4 22 6.1 22 8.8c0 3.7-3 7.7-10 12.2z"/></svg></span>Fes un donatiu</a>
 <script>
  // Header V7-G behaviour: menu disclosures, mobile menu toggle and search.
  document.documentElement.classList.add('js');
  const header = document.querySelector<HTMLElement>('.site-header');
  const mobile = document.querySelector<HTMLButtonElement>('.mobile-nav-toggle');
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-disclosure]')];
  const panelFor = (button: HTMLElement) => document.getElementById(button.getAttribute('aria-controls')!)!;
  const closeMenus = (except?: HTMLElement) => {
   for (const button of triggers) if (button !== except) { button.setAttribute('aria-expanded', 'false'); panelFor(button).hidden = true; }
  };
  for (const button of triggers) {
   button.addEventListener('click', () => {
    const opening = button.getAttribute('aria-expanded') !== 'true';
    closeMenus(button);
    button.setAttribute('aria-expanded', String(opening));
    panelFor(button).hidden = !opening;
   });
  }
  if (header) new ResizeObserver(() => {
   document.documentElement.style.setProperty('--navigation-panel-top', `${Math.ceil(header.getBoundingClientRect().height - 6)}px`);
  }).observe(header);
  const menuIcon = (open: boolean) => `${open ? 'Tanca' : 'Menú'} <svg class="v7-menu-icon" width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true"><path d="${open ? 'M6 6l14 14M20 6L6 20' : 'M4 7h18M4 13h18M4 19h18'}" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"/></svg>`;
  const search = document.querySelector<HTMLButtonElement>('.v7-search-toggle');
  const form = document.querySelector<HTMLFormElement>('#v7-search');
  const input = document.querySelector<HTMLInputElement>('#v7-search-query');
  const closeSearch = (restore: boolean) => {
   if (!form || !search) return;
   form.hidden = true; search.setAttribute('aria-expanded', 'false');
   if (restore) search.focus();
  };
  if (mobile) {
   mobile.hidden = false;
   mobile.addEventListener('click', () => {
    const opening = mobile.getAttribute('aria-expanded') !== 'true';
    mobile.setAttribute('aria-expanded', String(opening));
    mobile.innerHTML = menuIcon(opening);
    if (!opening) closeMenus();
    closeSearch(false);
   });
  }
  const collapseMobile = () => { if (mobile) { mobile.setAttribute('aria-expanded', 'false'); mobile.innerHTML = menuIcon(false); } };
  if (search && form && input) {
   search.addEventListener('click', () => {
    if (search.getAttribute('aria-expanded') === 'true') { closeSearch(true); return; }
    closeMenus(); collapseMobile();
    form.hidden = false; search.setAttribute('aria-expanded', 'true'); input.focus();
   });
   form.addEventListener('keydown', event => {
    if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); closeSearch(true); }
   }, true);
   document.addEventListener('click', event => {
    const target = event.target as Node;
    if (!form.hidden && !form.contains(target) && !search.contains(target)) closeSearch(false);
   });
  }
  document.addEventListener('click', event => { if (header && !header.contains(event.target as Node)) closeMenus(); });
  header?.addEventListener('focusout', () => setTimeout(() => { if (!header.contains(document.activeElement)) closeMenus(); }, 0));
  document.addEventListener('keydown', event => {
   if (event.key !== 'Escape') return;
   const expanded = triggers.find(button => button.getAttribute('aria-expanded') === 'true');
   if (expanded) { closeMenus(); expanded.focus(); event.preventDefault(); }
   else if (mobile?.getAttribute('aria-expanded') === 'true') { collapseMobile(); mobile.focus(); event.preventDefault(); }
  });
  header?.addEventListener('click', event => {
   if ((event.target as HTMLElement).closest('a')) { closeMenus(); collapseMobile(); }
  });
  // Sticky yellow strip on mobile (only the strip stays pinned) and floating donate on desktop.
  const mobileMq = window.matchMedia('(max-width: 959px)');
  const floatDonate = document.querySelector<HTMLElement>('.v7-float-donate');
  const searchToggle = document.querySelector<HTMLElement>('.v7-search-toggle');
  const updatePin = () => {
   if (!header || !searchToggle) return;
   const nav = header.querySelector<HTMLElement>('.main-nav');
   const pin = mobileMq.matches ? Math.max(0, searchToggle.offsetTop - 10) : Math.max(0, nav?.offsetTop ?? 0);
   header.style.setProperty('--v7-pin', `${pin}px`);
   header.classList.toggle('is-stuck', mobileMq.matches && window.scrollY > pin);
   // Desktop: the pinned menu bar slides away when the footer, which repeats the menu, comes into view.
   const footerTop = document.querySelector('.site-footer')?.getBoundingClientRect().top ?? Infinity;
   header.classList.toggle('is-footer', !mobileMq.matches && footerTop < header.offsetHeight - pin + 24);
  };
  const onScroll = () => {
   updatePin();
   const footerTop = document.querySelector('.site-footer')?.getBoundingClientRect().top ?? Infinity;
   floatDonate?.classList.toggle('is-visible', window.scrollY > 320 && footerTop > window.innerHeight - 40);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  onScroll();
  // Footer site map: sections stay open on desktop and collapse on mobile.
  const mapDetails = [...document.querySelectorAll<HTMLDetailsElement>('.footer-map details')];
  const wide = window.matchMedia('(min-width: 960px)');
  const syncMap = () => mapDetails.forEach(d => { d.open = wide.matches; d.querySelector('summary')!.tabIndex = wide.matches ? -1 : 0; });
  mapDetails.forEach(d => d.addEventListener('toggle', () => { if (wide.matches && !d.open) d.open = true; }));
  syncMap();
  wide.addEventListener('change', syncMap);
 </script>
</body>
</html>

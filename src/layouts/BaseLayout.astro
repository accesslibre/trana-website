---
import '../styles/global.css';
import '../styles/header-v7.css';
import SeoHead from '../components/SeoHead.astro';
import { buildSeoModel } from '../lib/seo';
interface Props { title: string; description?: string; seo?: Record<string, unknown> }
const { title, description, seo } = Astro.props;
const seoModel = buildSeoModel({ title, description, seo });
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="ca">
<head>
 <meta charset="utf-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1" />
 <SeoHead model={seoModel} />
 <meta name="theme-color" content="#1F2A5C" />
 <link rel="icon" href="/brand/trana-favicon.png" type="image/png" />
 <link rel="preload" href="/fonts/atkinson-400.ttf" as="font" type="font/ttf" crossorigin />
</head>
<body class="header-v7">
 <a class="skip" href="#main">Vés al contingut principal</a>
 <div class="site-shell">
 <header class="site-header"><a class="brand v7-brand" href="/" aria-current={path === '/' ? 'page' : undefined} aria-label="TRANA Andorra, Associació d’Esclerosi Múltiple. Inici"><img src="/brand/logo-trana-tif.png" fetchpriority="high" width="132" height="96" alt=""></a><div class="v7-utilities"><a class="hl v7-contact-link" href="tel:+376821345"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 3h3l1.5 4-2 1.2a10 10 0 0 0 4.3 4.3l1.2-2 4 1.5v3a2 2 0 0 1-2 2A12 12 0 0 1 3 5a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>+376 821 345</a><a class="hl v7-contact-link" href="mailto:info@tranandorra.org"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="m3 6 7 5 7-5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>info@tranandorra.org</a><button type="button" class="pill v7-search-toggle" aria-label="Cerca" aria-expanded="false" aria-controls="v7-search"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="2.4"/><path d="m13 13 4.5 4.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg><span class="v7-search-label">Cerca</span></button><a class="pill pill-yellow header-donate" href="/#collabora"><span class="donate-heart" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 21C5 16.5 2 12.5 2 8.8 2 6.1 4.1 4 6.7 4c1.9 0 3.7 1 5.3 3 1.6-2 3.4-3 5.3-3C19.9 4 22 6.1 22 8.8c0 3.7-3 7.7-10 12.2z"/></svg></span><span class="donate-text">Fes un donatiu</span><span class="donate-short" aria-hidden="true">Donatiu</span></a><a class="v7-stuck-donate" href="/#collabora" aria-label="Fes un donatiu"><span aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 21C5 16.5 2 12.5 2 8.8 2 6.1 4.1 4 6.7 4c1.9 0 3.7 1 5.3 3 1.6-2 3.4-3 5.3-3C19.9 4 22 6.1 22 8.8c0 3.7-3 7.7-10 12.2z"/></svg></span>Donatiu</a><button class="pill menu-toggle mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="navigation-options" hidden>Menú <svg class="v7-menu-icon" width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true"><path d="M4 7h18M4 13h18M4 19h18" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"/></svg></button></div><form id="v7-search" class="v7-search-form" action="/cerca/" method="get" role="search" hidden><label class="vh" for="v7-search-query">Cerca notícies</label><input id="v7-search-query" type="search" name="q" maxlength="200" placeholder="Cerca notícies"><button class="pill" type="submit">Cerca</button></form><nav class="nav-section main-nav" id="navigation-options" aria-label="Menú principal"><ul class="variant-nav"><li class="nav-entry "><button type="button" class="nav-trigger " data-disclosure aria-expanded="false" aria-controls="panel-0">L’esclerosi múltiple<span class="nav-chevron" aria-hidden="true"></span></button><div class="nav-panel wide" id="panel-0" style="--columns:2" hidden><section aria-labelledby="panel-0-heading-0"><h2 id="panel-0-heading-0">Entendre l’EM</h2><ul><li><a href="/que-es-lem/">Què és l’esclerosi múltiple?</a></li><li><a href="/glossari-em/">Glossari de l’EM</a></li><li><a href="https://www.lavanguardia.com/lv/brandslab/esclerosis-multiple-mil-caras-novartis-brl/">Les mil cares de l’EM</a></li></ul></section><section aria-labelledby="panel-0-heading-1"><h2 id="panel-0-heading-1">Salut i vida quotidiana</h2><ul><li><a href="/deteriorament-cognitiu-en-la-em/">Deteriorament cognitiu</a></li><li><a href="/afectacio-cognitiva-i-esclerosi-multiple/">Cognició i esclerosi múltiple</a></li><li><a href="/pla-integral-de-benestar-emocional-2/">Benestar emocional</a></li><li><a href="/decaleg-exercici-fisic-em/">Activitat física i EM</a></li></ul></section></div></li><li class="nav-entry "><button type="button" class="nav-trigger " data-disclosure aria-expanded="false" aria-controls="panel-1">Suport i activitats<span class="nav-chevron" aria-hidden="true"></span></button><div class="nav-panel wide" id="panel-1" style="--columns:2" hidden><section aria-labelledby="panel-1-heading-0"><h2 id="panel-1-heading-0">Activitats i tallers</h2><ul><li><a href="/activitats-2/">Activitats de TRANA</a></li><li><a href="/borrador-automatico/">Properes activitats</a></li><li><a href="/2024/05/els-tallers-neurocognitius-de-tranaem/">Tallers neurocognitius</a></li><li><a href="/2026/06/em-line-ajudeu-nos-a-la-seva-implantancio/">Tallers en línia EM-LINE</a></li></ul></section><section aria-labelledby="panel-1-heading-1"><h2 id="panel-1-heading-1">Suport i drets</h2><ul><li><a href="/pla-integral-de-benestar-emocional-2/">Benestar emocional</a></li><li><a href="/conveni-sobre-els-drets-de-les-persones-amb-discapacitat-cdpd/">Convenció de l’ONU (CDPD)</a></li><li><a href="/borrador-automatico-2/">Contacta amb TRANA</a></li></ul></section></div></li><li class="nav-entry "><button type="button" class="nav-trigger " data-disclosure aria-expanded="false" aria-controls="panel-2">Vivències<span class="nav-chevron" aria-hidden="true"></span></button><div class="nav-panel " id="panel-2" style="--columns:1" hidden><section aria-labelledby="panel-2-heading-0"><h2 id="panel-2-heading-0">Experiències personals</h2><ul><li><a href="/opinio/">Totes les vivències</a></li><li><a href="/sonia-araujo/">Sònia Araujo</a></li><li><a href="/nor-raguig/">Nor Raguig</a></li><li><a href="/el-nen-del-sola-dandorra/">El nen del Solà d’Andorra</a></li><li><a href="/jacint-risco/">Jacint Risco</a></li></ul></section></div></li><li class="nav-entry "><button type="button" class="nav-trigger " data-disclosure aria-expanded="false" aria-controls="panel-3">Actualitat<span class="nav-chevron" aria-hidden="true"></span></button><div class="nav-panel wide" id="panel-3" style="--columns:2" hidden><section aria-labelledby="panel-3-heading-0"><h2 id="panel-3-heading-0">Notícies i vídeos</h2><ul><li><a href="/noticies/">Notícies</a></li><li><a href="https://www.youtube.com/channel/UCn-SCjKNvcF3Azw3ZjPTlIA/videos">Vídeos a YouTube</a></li></ul></section><section aria-labelledby="panel-3-heading-1"><h2 id="panel-3-heading-1">Fotos i trobades</h2><ul><li><a href="https://www.flickr.com/photos/193066573@N04/albums/72157719250247126">Fotos de TRANA</a></li><li><a href="https://flic.kr/s/aHBqjCkZbX">Mulla’t 2025</a></li><li><a href="https://flic.kr/s/aHBqjCjc73">Dia Mundial de l’EM 2025</a></li><li><a href="https://flic.kr/s/aHBqjBssoc">Dia Mundial de l’EM 2024</a></li><li><a href="https://www.flickr.com/photos/193066573@N04/albums/72177720322935955">Dia Mundial de l’EM 2023</a></li><li><a href="https://www.flickr.com/photos/193066573@N04/albums/72177720322937796">Dia Mundial de l’EM 2022</a></li><li><a href="https://www.flickr.com/photos/193066573@N04/albums/72177720295460840">Nadal a TRANA</a></li><li><a href="https://www.flickr.com/photos/193066573@N04/albums/72157719889969314">Mou-te</a></li><li><a href="https://flic.kr/s/aHBqjBwmV6">Barbacoa 2024</a></li><li><a href="https://www.flickr.com/photos/193066573@N04/albums/72177720318966494">Protecció Civil 2024</a></li></ul></section></div></li><li class="nav-entry "><button type="button" class="nav-trigger " data-disclosure aria-expanded="false" aria-controls="panel-4">L’associació<span class="nav-chevron" aria-hidden="true"></span></button><div class="nav-panel wide" id="panel-4" style="--columns:2" hidden><section aria-labelledby="panel-4-heading-0"><h2 id="panel-4-heading-0">Coneix TRANA</h2><ul><li><a href="/acerca-de/">Qui som</a></li><li><a href="/historia/">Història</a></li><li><a href="/junta-associacio-tranaem/">Junta directiva</a></li><li><a href="/borrador-automatico-2/">Contacta amb TRANA</a></li></ul></section><section aria-labelledby="panel-4-heading-1"><h2 id="panel-4-heading-1">Documents</h2><ul><li><a href="/pla-estrategic-2020-2024/">Pla estratègic 2020–2024</a></li><li><a href="/estatuts/">Estatuts</a></li><li><a href="/memories-assemblea-general/">Memòries anuals</a></li></ul></section></div></li></ul></nav><div class="v7-color-rule" aria-hidden="true"><span style="background:#F7941D"></span><span style="background:#EF4337"></span><span style="background:#176BA3"></span><span style="background:#2A675C"></span><span style="background:#172736"></span></div></header>

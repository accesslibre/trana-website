---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Pàgina no trobada · TRANA" description="Torna a l'inici o cerca una notícia de TRANA.">
  <section class="not-found" aria-labelledby="not-found-title">
    <p>404</p>
    <h1 id="not-found-title">No hem trobat aquesta pàgina</h1>
    <p>Pots tornar a l’inici o cercar una notícia.</p>
    <nav aria-label="Continua navegant"><a href="/">Torna a l’inici</a><a href="/cerca/">Cerca notícies</a></nav>
  </section>
</BaseLayout>
<style>
  .not-found { max-width: 52rem; margin-inline: auto; padding: 80px 24px; }
  h1 { font-size: clamp(2.25rem, 5vw, 3rem); line-height: 1; text-wrap: balance; margin-block: 24px; }
  nav { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 32px; }
</style>

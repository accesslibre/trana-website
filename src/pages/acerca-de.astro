---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticlePage from '../components/pages/ArticlePage.astro';
import { getPageBySlug } from '../lib/wordpress/index';
const page = await getPageBySlug('acerca-de');
---
<BaseLayout title={`${page.title} · TRANA`} description={page.excerpt || undefined} seo={page.seo}>
  <ArticlePage post={page} kind="page" />
</BaseLayout>

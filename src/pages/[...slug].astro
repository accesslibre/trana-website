---
import type { WordPressPost } from '../lib/wordpress/index';
import { getAllPosts, getAllPages } from '../lib/wordpress/index';
import { contentRoutes, type PageMigration } from './_migration';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticlePage from '../components/pages/ArticlePage.astro';
export async function getStaticPaths() {
  const [posts, pages] = await Promise.all([getAllPosts(), getAllPages()]);
  return contentRoutes(posts, pages);
}
interface Props { post: WordPressPost; related: WordPressPost[]; kind: 'article' | 'page'; migration?: PageMigration }
const { post, related, kind, migration } = Astro.props;
---
<BaseLayout title={`${post.title} · TRANA`} description={post.excerpt || undefined} seo={post.seo}>
  <ArticlePage post={post} related={related} kind={kind} pendingReason={migration?.reason} resources={migration?.resources} />
</BaseLayout>

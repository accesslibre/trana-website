---
import type { WordPressPost } from '../../lib/wordpress/index';
import { getAllPosts } from '../../lib/wordpress/index';
import { paginatePosts } from '../../lib/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsList from '../../components/pages/NewsList.astro';
export async function getStaticPaths() {
  return paginatePosts(await getAllPosts()).map((pagination) => ({
    params: { page: pagination.page === 1 ? undefined : String(pagination.page) }, props: pagination,
  }));
}
interface Props { page: number; total: number; posts: WordPressPost[]; previous?: string; next?: string }
const { page } = Astro.props;
---
<BaseLayout title={`Notícies${page > 1 ? ` · Pàgina ${page}` : ''} · TRANA`} description="Actualitat i activitats de TRANA a Andorra.">
  <NewsList {...Astro.props} />
</BaseLayout>

---
// /contactans/: public contact data only. Address and phone come from this WordPress page; the e-mail and
// opening hours are published on the current TRANA website and the hours are still to be confirmed.
import '../../styles/pages.css';
import '../../styles/association-pages.css';
import Breadcrumbs from '../pages/Breadcrumbs.astro';
import Arrow from '../pages/Arrow.astro';
import type { WordPressPage } from '../../lib/wordpress/index';
import { CONTACT, formatPhone, type ContactData } from '../../lib/association-pages';
interface Props { post: WordPressPage; data: ContactData }
const { post, data } = Astro.props;
const phone = formatPhone(data.phone);
const social = [
  { label: 'Instagram', href: 'https://www.instagram.com/tranaemandorra/' },
  { label: 'Facebook', href: 'https://www.facebook.com/associaciotranaem.tranaem.5' },
  { label: 'X (Twitter)', href: 'https://twitter.com/em_trana' },
  { label: 'YouTube', href: 'https://www.youtube.com/channel/UCn-SCjKNvcF3Azw3ZjPTlIA/videos' },
];
const other = [
  { href: '/alta-soci/', title: 'Fer-te soci', text: 'Quota anual i contacte per fer l’alta.' },
  { href: '/alta-al-butlleti-de-noticies/', title: 'Butlletí de notícies', text: 'Com rebre les novetats.' },
  { href: '/noticies/', title: 'Notícies', text: 'Les últimes notícies de TRANA.' },
];
---
<div class="pg ap">
 <section class="pg-wrap ct-top" aria-labelledby="ct-title">
  <Breadcrumbs inline items={[{ label: 'L’associació', href: '/acerca-de/' }, { label: post.title }]} />
  <div class="ct-grid">
   <div>
    <p class="pg-eyebrow" style="--dot:var(--orange)">Línia d’atenció</p>
    <h1 id="ct-title">{post.title}</h1>
    <p class="pg-lede">Dades de contacte publicades per TRANA. Truca, escriu o vine al local d’Andorra la Vella.</p>
    <div class="ct-big">
     <a href={phone.href}><span class="ic"><svg width="28" height="28" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 3h3l1.5 4-2 1.2a10 10 0 0 0 4.3 4.3l1.2-2 4 1.5v3a2 2 0 0 1-2 2A12 12 0 0 1 3 5a2 2 0 0 1 2-2Z" stroke="#172736" stroke-width="1.8" stroke-linejoin="round"/></svg></span><span><small>Telèfon</small>{phone.text}</span></a>
     <a href={`mailto:${CONTACT.email}`}><span class="ic"><svg width="28" height="28" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="2" stroke="#172736" stroke-width="1.8"/><path d="m3 6 7 5 7-5" stroke="#172736" stroke-width="1.8" stroke-linejoin="round"/></svg></span><span><small>Correu electrònic</small>{CONTACT.email}</span></a>
    </div>
   </div>
   <aside class="ct-card pg-dark" aria-labelledby="visit-title">
    <h2 id="visit-title">Vine a veure’ns</h2>
    <address>Associació T.R.A.N.A. Andorra<br />{data.addressLines.map((l, i) => <>{l}{i < data.addressLines.length - 1 && <br />}</>)}</address>
    <dl class="ct-hours">
     {CONTACT.hours.map((h) => <div><dt>{h.days}</dt><dd>{h.time}</dd></div>)}
    </dl>
    <a class="pg-arrow" href={CONTACT.mapHref}><span>Com arribar-hi</span><Arrow /></a>
   </aside>
  </div>
 </section>

 <section class="pg-wrap ap-sec" aria-labelledby="sources-title">
  <h2 class="pg-h2" id="sources-title">D’on surten aquestes dades</h2>
  <ul class="ap-sources">
   <li><strong>Adreça i telèfon</strong><span>Publicats en aquesta pàgina del web de TRANA.</span></li>
   <li><strong>Correu electrònic i horari</strong><span>Publicats a la pàgina de contacte actual del web de TRANA. L’horari està pendent de confirmar amb l’associació, sobretot els festius.</span></li>
   <li><strong>No disponible</strong><span>El formulari de contacte del web antic no s’ha pogut recuperar. Utilitza el telèfon o el correu.</span></li>
  </ul>
 </section>

 <section class="pg-wrap ap-sec" aria-labelledby="altres-title">
  <h2 class="pg-h2" id="altres-title">Altres coses que potser busques</h2>
  <ul class="ap-cards ap-cards-3">
   {other.map((o) => <li><a href={o.href}><h3>{o.title}</h3><p>{o.text}</p><span class="pg-arrow"><span>Obre</span><Arrow /></span></a></li>)}
  </ul>
 </section>

 <section class="pg-wrap ct-social" aria-labelledby="social-title">
  <div><h2 id="social-title">Segueix-nos</h2><p style="margin-top:6px;font-size:17.5px">Xarxes socials de TRANA.</p></div>
  <ul>{social.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
 </section>
 <div class="ap-end"></div>
</div>

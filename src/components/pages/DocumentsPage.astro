---
import '../../styles/pages.css';
import Breadcrumbs from './Breadcrumbs.astro';
import { reports, docGroups, contact } from './samples';
const ext = (kind: string) => kind === 'Web' ? 'Obre la pàgina' : 'Obre el PDF';
---
<div class="pg">
 <header class="dc-top">
  <Breadcrumbs items={[{ label: 'L’associació', href: '/disseny/associacio/' }, { label: 'Documents' }]} />
  <div class="pg-wrap dc-top-inner">
   <div>
    <p class="pg-eyebrow" style="--dot:var(--green)">Transparència</p>
    <h1>Documents</h1>
    <p class="pg-lede">Estatuts, memòries anuals i textos de referència sobre drets. Els pots llegir en línia o descarregar.</p>
   </div>
   <div class="dc-find" role="search">
    <label for="doc-filter">Busca un document</label>
    <div class="field">
     <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="2.4"/><path d="m13 13 4.5 4.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
     <input id="doc-filter" type="search" placeholder="Per exemple: memòria 2023" autocomplete="off" aria-describedby="doc-count" />
    </div>
    <p id="doc-count" aria-live="polite"></p>
   </div>
  </div>
 </header>

 <div class="pg-wrap dc-body">
  <section class="dc-sec" aria-labelledby="mem-title" data-doc-group>
   <header><h2 id="mem-title">Memòries anuals</h2><p>Què hem fet cada any, explicat a l’assemblea.</p></header>
   <ul class="dc-years">
    {reports.map((r) => (
     <li data-doc={`${r.title} memòria anual ${r.year}`}>
      {r.missing ? (
       <div class="gone"><strong>{r.year}</strong><span>Ara no està disponible. <a href={`mailto:${contact.email}?subject=${encodeURIComponent(r.title)}`}>Demana-la per correu</a></span></div>
      ) : (
       <a href={r.href}><strong>{r.year}</strong><span>{r.title}<br />{r.kind} · {r.size}</span></a>
      )}
     </li>
    ))}
   </ul>
  </section>

  {docGroups.map((g) => (
   <section class="dc-sec" aria-labelledby={`g-${g.id}`} data-doc-group>
    <header><h2 id={`g-${g.id}`}>{g.title}</h2><p>{g.intro}</p></header>
    <ul class="dc-list">
     {g.items.map((d) => (
      <li data-doc={`${d.title} ${d.detail ?? ''}`}>
       <div class="dc-row">
        <span class:list={['dc-badge', { web: d.kind === 'Web' }]} aria-hidden="true">{d.kind === 'Web' ? <svg width="22" height="22" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7.5" stroke="#fff" stroke-width="1.8"/><path d="M2.5 10h15M10 2.5c2.200 2.300 2.200 12.700 0 15M10 2.5c-2.200 2.300-2.200 12.700 0 15" stroke="#fff" stroke-width="1.8"/></svg> : 'PDF'}</span>
        <div>
         <h3><a href={d.href}>{d.title}</a></h3>
         <p>{[d.detail, d.size && `${d.kind}, ${d.size}`].filter(Boolean).join(' · ')}</p>
        </div>
        <span class="dc-act" aria-hidden="true">{ext(d.kind)}<svg width="10" height="16" viewBox="0 0 10 16" fill="none"><path d="m2 2 6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
       </div>
      </li>
     ))}
    </ul>
   </section>
  ))}

  <p class="dc-empty" data-doc-empty hidden>No hem trobat cap document amb aquestes paraules. Prova amb una altra paraula o escriu-nos.</p>
 </div>

 <div class="pg-wrap">
  <aside class="dc-ask" aria-labelledby="ask-title">
   <div>
    <h2 id="ask-title">No trobes el que busques?</h2>
    <p>Si ets soci i necessites les actes o un altre document, demana’ns-el per correu.</p>
   </div>
   <a class="pill pill-ink" href={`mailto:${contact.email}?subject=${encodeURIComponent('Petició de document')}`} style="min-height:52px">Escriu-nos</a>
  </aside>
 </div>
</div>

<script>
 // Progressive enhancement: filter the lists while typing. Without JavaScript every document stays visible.
 const input = document.querySelector<HTMLInputElement>('#doc-filter');
 const count = document.querySelector<HTMLElement>('#doc-count');
 const empty = document.querySelector<HTMLElement>('[data-doc-empty]');
 const items = [...document.querySelectorAll<HTMLElement>('[data-doc]')];
 const groups = [...document.querySelectorAll<HTMLElement>('[data-doc-group]')];
 const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
 input?.addEventListener('input', () => {
  const words = norm(input.value).split(/\s+/).filter(Boolean);
  let shown = 0;
  for (const item of items) {
   const hay = norm(item.dataset.doc ?? '');
   const ok = words.every((w) => hay.includes(w));
   item.hidden = !ok; if (ok) shown++;
  }
  for (const g of groups) g.hidden = !g.querySelector('[data-doc]:not([hidden])');
  if (empty) empty.hidden = shown > 0;
  if (count) count.textContent = words.length ? `${shown} ${shown === 1 ? 'document' : 'documents'}` : '';
 });
</script>

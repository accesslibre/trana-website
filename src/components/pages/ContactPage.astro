---
import '../../styles/pages.css';
import Breadcrumbs from './Breadcrumbs.astro';
import Arrow from './Arrow.astro';
import { contact } from './samples';
const mail = (subject: string) => `mailto:${contact.email}?subject=${encodeURIComponent(subject)}`;
const reasons = [
 { title: 'Acabo de rebre el diagnòstic', text: 'Parlem-ne amb calma. T’expliquem què fem i com et podem acompanyar, a tu i a la teva família.', subject: 'Acabo de rebre el diagnòstic' },
 { title: 'Vull participar en una activitat', text: 'Tallers neurocognitius, ioga adaptat, musicoteràpia o atenció psicològica.', subject: 'Vull participar en una activitat' },
 { title: 'Vull fer-me soci o voluntari', text: 'Una quota estable o unes hores del teu temps ens ajuden a mantenir els tallers.', subject: 'Vull fer-me soci o voluntari' },
 { title: 'Represento una entitat o un mitjà', text: 'Col·laboracions, premsa i propostes per a la defensa de drets.', subject: 'Col·laboració o premsa' },
];
const social = [
 { label: 'Instagram', icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>', href: 'https://www.instagram.com/tranaemandorra/' },
 { label: 'Facebook', icon: '<svg width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M14 8h2V5h-2.5C11 5 10 6.6 10 8.5V10H8v3h2v6h3v-6h2.2l.4-3H13V8.7c0-.5.2-.7 1-.7z"/></svg>', href: 'https://www.facebook.com/associaciotranaem.tranaem.5' },
 { label: 'YouTube', icon: '<svg width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3L10 15z"/></svg>', href: 'https://www.youtube.com/channel/UCn-SCjKNvcF3Azw3ZjPTlIA/videos' },
 { label: 'X (Twitter)', icon: '<svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M17.75 3h3.08l-6.73 7.69L22 21h-6.2l-4.85-6.34L5.4 21H2.32l7.2-8.23L2 3h6.36l4.39 5.8L17.75 3zm-1.08 16.15h1.71L7.4 4.76H5.57l11.1 14.39z"/></svg>', href: 'https://twitter.com/em_trana' },
];
---
<div class="pg">
 <section class="pg-wrap ct-top" aria-labelledby="ct-title">
  <Breadcrumbs inline items={[{ label: 'L’associació', href: '/disseny/associacio/' }, { label: 'Contacte' }]} />
  <div class="ct-grid">
   <div>
    <p class="pg-eyebrow" style="--dot:var(--orange)">Línia d’atenció</p>
    <h1 id="ct-title">Parlem</h1>
    <p class="pg-lede">Truca’ns, escriu-nos o vine al local d’Andorra la Vella. Si tu o la teva família no sabeu per on començar, comenceu per aquí.</p>
    <div class="ct-big">
     <a href={contact.phoneHref}><span class="ic"><svg width="28" height="28" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 3h3l1.5 4-2 1.2a10 10 0 0 0 4.3 4.3l1.2-2 4 1.5v3a2 2 0 0 1-2 2A12 12 0 0 1 3 5a2 2 0 0 1 2-2Z" stroke="#172736" stroke-width="1.8" stroke-linejoin="round"/></svg></span><span><small>Truca’ns</small><strong>{contact.phone}</strong></span></a>
     <a href={`mailto:${contact.email}`}><span class="ic"><svg width="28" height="28" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="2" stroke="#172736" stroke-width="1.8"/><path d="m3 6 7 5 7-5" stroke="#172736" stroke-width="1.8" stroke-linejoin="round"/></svg></span><span><small>Escriu-nos</small><strong>{contact.email}</strong></span></a>
    </div>
   </div>
   <aside class="ct-card pg-dark" aria-labelledby="visit-title">
    <h2 id="visit-title">Vine a veure’ns</h2>
    <address>Associació T.R.A.N.A. Andorra<br />{contact.address[0]}<br />{contact.address[1]}</address>
    <p class="ct-status" data-status hidden></p>
    <dl class="ct-hours">
     <div><dt>Dilluns a divendres</dt><dd>9–13 h i 15–18 h</dd></div>
     <div><dt>Dissabte, diumenge i festius</dt><dd>Tancat</dd></div>
    </dl>
    <a class="pg-arrow" href={contact.mapHref}><span>Com arribar-hi</span><Arrow /></a>
   </aside>
  </div>
 </section>

 <section class="ct-why" aria-labelledby="why-title">
  <div class="pg-wrap">
   <h2 class="pg-h2" id="why-title">Què necessites?</h2>
   <ul>
    {reasons.map((r) => <li><h3>{r.title}</h3><p>{r.text}</p><a class="pg-arrow" href={mail(r.subject)}><span>Escriu-nos sobre això</span><Arrow /></a></li>)}
   </ul>
  </div>
 </section>

 <section class="pg-wrap ct-social" aria-labelledby="social-title">
  <div>
   <h2 id="social-title">Segueix-nos</h2>
   <p style="margin-top:6px;font-size:17.5px">Fotos de les trobades, notícies i vídeos.</p>
  </div>
  <ul>
   {social.map((s) => <li><a href={s.href}><span aria-hidden="true" set:html={s.icon} />{s.label}</a></li>)}
  </ul>
 </section>
</div>

<script>
 // Opening status in Andorra time. Public holidays are not known here, so the text says so.
 const el = document.querySelector<HTMLElement>('[data-status]');
 if (el) {
  const parts = Object.fromEntries(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Andorra', weekday: 'short', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' }).formatToParts(new Date()).map((p) => [p.type, p.value]));
  const day = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'].includes(parts.weekday);
  const t = Number(parts.hour) * 60 + Number(parts.minute);
  const slots: [number, number][] = [[540, 780], [900, 1080]];
  const open = day && slots.find(([a, b]) => t >= a && t < b);
  if (open) { el.textContent = `Ara obert, fins a les ${open[1] / 60} h`; el.classList.add('open'); }
  else {
   let when = 'dilluns a les 9 h';
   if (day && t < 540) when = 'avui a les 9 h';
   else if (day && t >= 780 && t < 900) when = 'avui a les 15 h';
   else if (day && parts.weekday !== 'Fri') when = 'demà a les 9 h';
   el.textContent = `Ara tancat. Obrim ${when}`;
   el.classList.add('closed');
  }
  el.hidden = false;
 }
</script>
